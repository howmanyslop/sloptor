{
	"version": 1,
	"flameworkVersion": "1.3.2",
	"identifiers": {
		"rotor-flamework-task4-oracle:out/server/class-decorator-di.server@LoggerService": "task4:server/class-decorator-di.server@LoggerService",
		"rotor-flamework-task4-oracle:out/server/class-decorator-di.server@ConsumerService": "task4:server/class-decorator-di.server@ConsumerService",
		"rotor-flamework-task4-oracle:out/server/class-decorator-di.server@Tracked": "task4:server/class-decorator-di.server@Tracked",
		"rotor-flamework-task4-oracle:out/shared/component-attributes@FixtureComponent": "task4:shared/component-attributes@FixtureComponent",
		"rotor-flamework-task4-oracle:out/shared/macros@Payload": "task4:shared/macros@Payload",
		"rotor-flamework-task4-oracle:out/shared/networking@events": "task4:shared/networking@events",
		"rotor-flamework-task4-oracle:out/shared/networking@functions": "task4:shared/networking@functions"
	},
	"metadata": {
		"config": {
			"logLevel": "none",
			"profiling": false,
			"disableDependencyWarnings": false
		},
		"globs": {
			"paths": {
				"src/**/*.ts": [
					"out/shared/networking.lua",
					"out/shared/macros.lua",
					"out/shared/guards.lua",
					"out/shared/component-attributes.lua",
					"out/server/class-decorator-di.server.lua"
				]
			},
			"origins": {
				"src/shared/macros.ts": [
					"src/**/*.ts"
				]
			}
		}
	},
	"identifierPrefix": "task4",
	"stringHashes": {
		"task4:payload": "00000000-0000-4000-8000-000000000004"
	}
}
