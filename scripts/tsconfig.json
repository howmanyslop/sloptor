{
	"extends": "../tsconfig.node.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/scripts.tsbuildinfo",
		"paths": {
			"$commands/*": ["./commands/*"],
			"$constants/*": ["./constants/*"],
			"$errors/*": ["./errors/*"],
			"$functions/*": ["./functions/*"],
			"$types/*": ["./types/*"],
			"$utilities/*": ["./utilities/*"]
		}
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules"]
}
