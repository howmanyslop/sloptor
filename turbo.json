{
	"$schema": "https://turborepo.dev/schema.json",
	"globalDependencies": ["mise.lock", "tsconfig*.json"],
	"globalPassThroughEnv": ["NODE_OPTIONS"],
	"tasks": {
		"//#type-check:root": {
			"dependsOn": ["^transit"],
			"inputs": ["$TURBO_DEFAULT$", "scripts/utilities/release-utilities.ts"]
		},
		"transit": {
			"dependsOn": ["^transit"]
		},
		"type-check": {
			"dependsOn": ["transit"]
		}
	}
}
