{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"assist": {
		"actions": {
			"source": {
				"noDuplicateClasses": "on",
				"organizeImports": "off",
				"preset": "recommended",
				"useSortedAttributes": "off",
				"useSortedEnumMembers": "on",
				"useSortedInterfaceMembers": "off",
				"useSortedKeys": {
					"level": "off",
					"options": {
						"groupByNesting": false,
						"sortOrder": "lexicographic"
					}
				},
				"useSortedPackageJson": "off",
				"useSortedProperties": "on",
				"useSortedSelectionSet": "on",
				"useSortedTypeFields": "on"
			}
		},
		"enabled": true,
		"includes": ["**", "!**/*.js", "!**/*-lock.{json,yaml}"]
	},

	"css": {
		"assist": { "enabled": true },
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"indentWidth": 4,
			"lineWidth": 120,
			"quoteStyle": "double"
		},
		"globals": [],
		"linter": { "enabled": true }
	},

	"files": {
		"includes": [
			"**",
			"!**/package.json",
			"!**/*.js",
			"!**/*-lock.{json,yaml}",
			"!scripts/clis/**/*.ts",
			"!**/.opencode/goals",
			"!src/generated/dictionary-verbs.ts",
			"!.mise"
		]
	},

	"formatter": {
		"attributePosition": "auto",
		"bracketSameLine": false,
		"bracketSpacing": true,
		"enabled": true,
		"expand": "auto",
		"formatWithErrors": true,
		"includes": [
			"**",
			"!**/*.js",
			"!**/{dist,do-not-sync-ever,garbage,node_modules}/**",
			"!documentation/src/components/rule-index-data.ts",
			"!tests/fixtures/tsgolint-version/**/*.yaml"
		],
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineEnding": "lf",
		"lineWidth": 120,
		"useEditorconfig": false
	},

	"graphql": {
		"assist": { "enabled": true },
		"formatter": {
			"bracketSpacing": true,
			"enabled": true,
			"indentStyle": "tab",
			"indentWidth": 4,
			"lineWidth": 120,
			"quoteStyle": "double"
		},
		"linter": { "enabled": true }
	},

	"grit": {
		"assist": { "enabled": true },
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"indentWidth": 4,
			"lineWidth": 120
		},
		"linter": { "enabled": true }
	},

	"html": {
		"assist": { "enabled": true },
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"attributePosition": "auto",
			"bracketSameLine": true,
			"enabled": true,
			"indentScriptAndStyle": true,
			"indentStyle": "tab",
			"indentWidth": 4,
			"lineEnding": "lf",
			"lineWidth": 120,
			"selfCloseVoidElements": "always",
			"whitespaceSensitivity": "strict"
		},
		"linter": { "enabled": true },
		"parser": {
			"interpolation": true,
			"vue": false
		}
	},

	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"attributePosition": "auto",
			"bracketSameLine": false,
			"bracketSpacing": true,
			"enabled": true,
			"expand": "auto",
			"indentStyle": "tab",
			"indentWidth": 4,
			"jsxQuoteStyle": "double",
			"lineEnding": "lf",
			"lineWidth": 120,
			"quoteProperties": "asNeeded",
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		},
		"globals": ["Bun"],
		"linter": { "enabled": true }
	},

	"json": {
		"assist": { "enabled": true },
		"formatter": {
			"bracketSpacing": true,
			"enabled": true,
			"expand": "auto",
			"indentStyle": "tab",
			"indentWidth": 4,
			"lineWidth": 120,
			"trailingCommas": "none"
		},
		"linter": { "enabled": true },
		"parser": {}
	},

	"linter": {
		"domains": {
			"project": "all",
			"react": "all",
			"types": "all"
		},
		"enabled": true,
		"includes": ["**", "!**/{dist,do-not-sync-ever,garbage,node_modules}/**"],
		"rules": {
			"a11y": { "preset": "none" },

			"complexity": {
				"noDivRegex": "error",
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": {
						"maxAllowedComplexity": 15
					}
				},
				"noExcessiveNestedTestSuites": "error",
				"noForEach": "error",
				"noImplicitCoercions": "error",
				"noRedundantDefaultExport": "error",
				"noUselessCatchBinding": "error",
				"noUselessReturn": "error",
				"noUselessStringConcat": "error",
				"noUselessSwitchCase": "off",
				"preset": "none",
				"useArrayFind": "error",
				"useArrowFunction": "off",
				"useDateNow": "error",
				"useFlatMap": "error",
				"useLiteralKeys": "error",
				"useMaxParams": {
					"level": "off",
					"options": { "max": 7 }
				},
				"useOptionalChain": "error",
				"useSimpleNumberKeys": "error",
				"useSimplifiedLogicExpression": "off",
				"useWhile": "error"
			},

			"correctness": {
				"noGlobalDirnameFilename": "error",
				"noNodejsModules": "off",
				"noUndeclaredDependencies": {
					"level": "error",
					"options": {}
				},
				"noUndeclaredVariables": {
					"level": "error",
					"options": { "checkTypes": true }
				},
				"noUnresolvedImports": "off",
				"noUnusedImports": "error",
				"noUnusedInstantiation": "error",
				"noUnusedPrivateClassMembers": "error",
				"noUnusedVariables": "error",
				"preset": "recommended",
				"useImportExtensions": "off",
				"useInlineScriptId": "error",
				"useJsonImportAttributes": "off",
				"useSingleJsDocAsterisk": "error"
			},

			"nursery": {
				"noAstroSetHtmlDirective": "error",
				"noBaseToString": "off",
				"noBunModules": "error",
				"noComponentHookFactories": "error",
				"noConditionalExpect": "off",
				"noDrizzleDeleteWithoutWhere": "error",
				"noDrizzleUpdateWithoutWhere": "error",
				"noDuplicateFieldDefinitionNames": "error",
				"noDuplicateSelectors": "error",
				"noEmptyObjectKeys": "error",
				"noExcessiveNestedCallbacks": {
					// temporarily disabled
					"level": "off",
					"options": { "max": 5 }
				},
				"noExcessiveSelectorClasses": "error",
				"noExtendNative": "error",
				"noFloatingPromises": "error",
				"noIdenticalTestTitle": "error",
				"noImpliedEval": "error",
				"noInlineStyles": "error",
				"noInvalidFileInputAccept": "error",
				"noInvalidPropertyInitValue": "error",
				"noJsRestrictedProperties": "error",
				"noJsonUnsafeValues": "error",
				"noJsxLeakedDollar": "error",
				"noJsxNamespace": "error",
				"noLoopFunc": "error",
				"noMisleadingReturnType": "off",
				"noMisusedPromises": "error",
				"noNegationInEqualityCheck": "error",
				"noNonScalableViewport": "error",
				"noObsoleteTags": "error",

				"noReactStringRefs": "error",
				"noRestrictedDependencies": "error",
				"noReturnInFinally": "error",
				"noSvelteAtDebugTags": "error",
				"noSvelteAtHtmlTags": "error",
				"noSvelteLegacyConst": "error",
				"noSvelteUnnecessaryStateWrap": "error",
				"noTailwindArbitraryValue": "error",
				"noThisOutsideOfClass": "error",
				"noTopLevelLiterals": "error",
				// does not play nicely with Astro
				"noUndeclaredClasses": "off",
				// what is this lol
				"noUndeclaredCustomProperties": "off",
				"noUnmodifiedLoopCondition": "error",
				"noUnnecessaryTemplateExpression": "error",
				"noUnsafeIframeSandbox": "error",
				"noUnsafePlusOperands": "error",
				"noUnsafeTypeAssertion": "off",
				"noUntrustedLicenses": "error",
				// does NOT work with mdx
				"noUnusedClasses": "off",
				"noUselessTypeConversion": "off",
				"noVueDeprecatedScopedSlots": "error",
				"noVueImportCompilerMacros": "error",
				"noVueRefAsOperand": "error",
				"noVueUndeclaredDirectives": "error",
				"noVueVOnNumberValues": "error",
				"noXorAsExponentiation": "error",
				"preset": "recommended",
				"useArraySome": "error",
				"useAstroClientOnlyDirectiveValue": "error",
				"useAwaitThenable": "error",
				"useBaseline": {
					"level": "error",
					"options": {
						"allowSelectors": ["selection", "marker"],
						"available": "newly"
					}
				},
				"useBetterDomTraversing": "error",
				"useConsistentFunctionStyle": {
					"level": "error",
					"options": {
						"allowArrowFunctions": false,
						"style": "declaration"
					}
				},
				"useConsistentObjectKeys": "error",
				"useConsistentTestIt": "error",
				"useControlLabel": "error",
				"useDisposables": "error",
				"useDomNodeTextContent": "error",
				"useDomQuerySelector": "error",
				"useExhaustiveSwitchCases": "error",
				"useExpect": "off",
				"useExplicitReturnType": "error",
				"useExplicitType": "off",
				"useFlatMathMinMax": "error",
				"useIframeSandbox": "error",
				"useImportsFirst": "off",
				"useIncludes": "error",
				// i do not know what this is
				"useLayeredStyles": "off",
				"useMathMinMax": "error",
				"useModernMathApis": "error",
				"useNamedCaptureGroup": "error",
				"useNamedLayer": "error",
				"useNullishCoalescing": "error",
				"useReactCompiler": {
					"level": "error",
					"options": {
						"compilationMode": "infer"
					}
				},
				"useReactNamingConvention": "error",
				"useReduceTypeParameter": "error",
				"useRegexpExec": "error",
				"useRegexpTest": "error",
				"useScopedStyles": "error",
				"useSortedClasses": "error",
				"useStringStartsEndsWith": "error",
				"useTailwindShorthandClasses": "error",
				"useTestHooksInOrder": "error",
				"useTestHooksOnTop": "error",
				"useThisInClassMethods": "error",
				"useUnicodeRegex": "error",
				"useValidTestTitle": "error",
				"useVarsOnTop": "error"
			},

			"performance": {
				"noAccumulatingSpread": "error",
				"noAwaitInLoops": "off",
				"noDelete": "error",
				"noJsxPropsBind": "off",
				"noSyncScripts": "error",
				"preset": "recommended",
				"useSolidForComponent": "off",
				"useTopLevelRegex": "error"
			},

			"security": {
				"noDangerouslySetInnerHtml": "off",
				"noScriptUrl": "error",
				"preset": "recommended"
			},

			"style": {
				"noCommonJs": "error",
				"noDefaultExport": "off",
				"noDescendingSpecificity": "error",
				"noDoneCallback": "error",
				"noEnum": "off",
				"noExcessiveClassesPerFile": {
					"level": "error",
					"options": { "maxClasses": 3 }
				},
				"noExcessiveLinesPerFile": {
					"level": "off",
					"options": {
						"maxLines": 200,
						"skipBlankLines": true
					}
				},
				"noExportedImports": "error",
				"noHeadElement": "error",
				"noImplicitBoolean": "error",
				"noInferrableTypes": "error",
				"noJsxLiterals": "error",
				"noMagicNumbers": "off",
				"noMultiAssign": "error",
				"noMultilineString": "error",
				"noNamespace": "error",
				"noNegationElse": "error",
				"noNestedTernary": "error",
				"noNonNullAssertion": "off",
				"noParameterAssign": "error",
				"noParameterProperties": "error",
				"noProcessEnv": "error",
				"noRestrictedGlobals": "error",
				"noRestrictedImports": "error",
				"noRestrictedTypes": {
					"level": "error",
					"options": {
						"types": {
							"Omit": {
								"message": "Use Except from type-fest instead.",
								"use": "Except"
							}
						}
					}
				},
				"preset": "recommended",
				"useArrayLiterals": "off",
				"useBlockStatements": "off",
				"useConsistentEnumValueType": "error",
				"useConsistentMemberAccessibility": "off",
				"useConsistentMethodSignatures": "off",
				"useConst": {
					"fix": "safe",
					"level": "error"
				},
				"useDefaultParameterLast": "error",
				"useDestructuring": "off",
				"useErrorCause": "error",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case"],
						"requireAscii": true
					}
				},
				"useGlobalThis": "error",
				"useSpreadOverApply": "error"
			},

			"suspicious": {
				"noAlert": "error",
				"noApproximativeNumericConstant": "error",
				"noArrayIndexKey": "error",
				"noConfusingVoidType": "off",
				"noConstEnum": "off",
				"noControlCharactersInRegex": "off",
				"noDuplicateEnumValues": "error",
				"noEmptyBlockStatements": "error",
				"noEqualsToNull": "error",
				"noForIn": "error",
				"noNestedPromises": "error",
				"noParametersOnlyUsedInRecursion": "error",
				"noProto": "error",
				"noReturnAssign": "error",
				"noShadow": {
					"level": "off",
					"options": {
						"ignoreFunctionTypeParameterNameValueShadow": false,
						"ignoreTypeValueShadow": false
					}
				},
				"noTemplateCurlyInString": "off",
				"noUndeclaredEnvVars": "error",
				"noUnnecessaryConditions": "off",
				"preset": "recommended",
				"useArraySortCompare": "error"
			}
		}
	},

	"overrides": [
		// JSONC Files
		{
			"includes": ["**/*.jsonc", "!**/biome.jsonc"],
			"json": {
				"formatter": {
					"enabled": true,
					"indentStyle": "tab",
					"indentWidth": 4,
					"lineWidth": 120,
					"trailingCommas": "all"
				},
				"linter": { "enabled": true },
				"parser": {
					"allowComments": true,
					"allowTrailingCommas": true
				}
			}
		},

		// JSON Files
		{
			"includes": [],
			"json": {
				"formatter": {
					"enabled": true,
					"indentStyle": "tab",
					"indentWidth": 4,
					"lineWidth": 120,
					"trailingCommas": "none"
				},
				"linter": { "enabled": true },
				"parser": {
					"allowComments": false,
					"allowTrailingCommas": false
				}
			}
		},

		{
			"includes": ["**/*.test.ts"],
			"linter": {
				"rules": {
					"performance": {
						"useTopLevelRegex": "off"
					},
					"style": {
						"noExcessiveLinesPerFile": "off"
					}
				}
			}
		},

		{
			"includes": ["tests/fixtures/**/*"],
			"linter": {
				"rules": {
					"correctness": {
						"noUndeclaredDependencies": "off"
					},
					"style": {
						"useImportType": "off"
					}
				}
			}
		},

		{
			"includes": ["*.config.{ts,mjs}"],
			"linter": {
				"rules": {
					"style": {
						"noProcessEnv": "off"
					}
				}
			}
		},

		{
			"assist": {
				"actions": {
					"source": {
						"useSortedAttributes": "off"
					}
				}
			},
			"includes": [
				"documentation/src/components/badge.astro",
				"documentation/src/components/icon.astro",
				"documentation/src/components/rule-example.astro"
			]
		},

		{
			"includes": [
				"documentation/src/components/related-rules.astro",
				"documentation/src/components/release-history.astro",
				"documentation/src/components/rule-diagnostics.astro",
				"documentation/src/components/rule-examples.astro",
				"documentation/src/components/rule-options.astro",
				"documentation/src/components/rule-options-table.tsx"
			],
			"linter": {
				"rules": {
					"performance": {
						"useSolidForComponent": "off"
					},
					"style": {
						"noJsxLiterals": "off"
					}
				}
			}
		},

		{
			"assist": {
				"actions": {
					"source": {
						"useSortedAttributes": "off"
					}
				}
			},
			"includes": ["documentation/src/components/rule-page.astro"]
		},

		{
			"includes": ["documentation/src/**/*.astro", "tests/fixtures/**/*.tsx"],
			"linter": {
				"domains": {
					"react": "none"
				}
			}
		},

		{
			// Theme stylesheet uses component-scoped selectors across disjoint
			// subtrees (code resets, badges, cards); specificity ordering between
			// unrelated components is intentional and has no cascade effect.
			"includes": ["documentation/src/styles/custom.css"],
			"linter": {
				"rules": {
					"style": {
						"noDescendingSpecificity": "off"
					}
				}
			}
		},

		{
			"includes": ["**/*.test.ts", "scripts/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveCognitiveComplexity": "off"
					}
				}
			}
		},

		{
			"includes": ["scripts/**/*.{ts,tsx}"],
			"linter": {
				"rules": {
					"nursery": {
						"noBunModules": "off"
					}
				}
			}
		},

		{
			"includes": ["documentation/src/components/**/*.tsx"],
			"linter": {
				"rules": {
					"nursery": {
						"useReactFunctionComponentDefinition": {
							"level": "error",
							"options": {
								"namedComponents": "functionDeclaration"
							}
						}
					}
				}
			}
		},

		{
			"includes": ["documentation/tests/browser/**/*.test.ts"],
			"linter": {
				"rules": {
					"nursery": {
						"noPlaywrightElementHandle": "error",
						"noPlaywrightEval": "error",
						"noPlaywrightForceOption": "error",
						"noPlaywrightMissingAwait": "error",
						"noPlaywrightNetworkidle": "error",
						"noPlaywrightPagePause": "error",
						"noPlaywrightUselessAwait": "error",
						"noPlaywrightWaitForNavigation": "error",
						"noPlaywrightWaitForSelector": "error",
						"noPlaywrightWaitForTimeout": "error",
						"usePlaywrightValidDescribeCallback": "error"
					}
				}
			}
		},

		{
			"assist": {
				"actions": {
					"source": {
						"useSortedKeys": {
							"level": "on",
							"options": {
								"groupByNesting": false,
								"sortOrder": "lexicographic"
							}
						}
					}
				},
				"enabled": true
			},
			"includes": ["**/*.{jsonc,json}", "!**/package.json", "!**/tsconfig*.json", "!src/default-properties.json"]
		},

		{
			"includes": ["**/*.svg"],
			"linter": {
				"rules": {
					"nursery": {
						"noUnusedClasses": "off",
						"useLayeredStyles": "off"
					}
				}
			}
		}

		// package.json exception
		// {
		// 	"assist": {
		// 		"actions": {
		// 			"source": {
		// 				"useSortedKeys": "off",
		// 				"useSortedPackageJson": "on"
		// 			}
		// 		}
		// 	},
		// 	"formatter": { "enabled": false },
		// 	"includes": ["package.json"]
		// }
	],

	"vcs": {
		"clientKind": "git",
		"defaultBranch": "main",
		"enabled": true,
		"useIgnoreFile": true
	}
}
