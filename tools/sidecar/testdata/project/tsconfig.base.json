{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "transform": "./plugins/prefix-string.js",
        "prefix": "inherited",
        "after": true
      }
    ]
  },
  "include": ["src/**/*.ts"]
}
