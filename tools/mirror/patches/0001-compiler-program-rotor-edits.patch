+// resolutionsKeepingExistingFileSet re-resolves imports for newFile when import shape changed.
+// It succeeds only when non-import shape fields still match and every successful resolution
+// already points at a SourceFile in this program. Unresolved imports are allowed.
+func (p *Program) resolutionsKeepingExistingFileSet(oldFile, newFile *ast.SourceFile) (module.ModeAwareCache[*module.ResolvedModule], bool) {
+	if !canReplaceFileIgnoringImports(oldFile, newFile) {
+		return nil, false
+	}
+
+	moduleNames := make([]*ast.Node, 0, len(newFile.Imports())+len(newFile.ModuleAugmentations))
+	moduleNames = append(moduleNames, newFile.Imports()...)
+	for _, augmentation := range newFile.ModuleAugmentations {
+		if augmentation.Kind == ast.KindStringLiteral {
+			moduleNames = append(moduleNames, augmentation)
+		}
+	}
+	resolutions := make(module.ModeAwareCache[*module.ResolvedModule], len(moduleNames))
+	for _, entry := range moduleNames {
+		moduleName := entry.Text()
+		if moduleName == "" {
+			continue
+		}
+		mode := p.GetModeForUsageLocation(newFile, entry)
+		resolved := p.ResolveModuleName(moduleName, newFile.FileName(), mode)
+		resolutions[module.ModeAwareCacheKey{Name: moduleName, Mode: mode}] = resolved
+		if resolved == nil || !resolved.IsResolved() {
+			continue
+		}
+		resolvedPath := p.toPath(resolved.ResolvedFileName)
+		if _, ok := p.filesByPath[resolvedPath]; !ok {
+			// Successful resolution to a file not already loaded requires a full rebuild.
+			return nil, false
+		}
+	}
+	return resolutions, true
+}
