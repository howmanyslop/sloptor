amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"

min_hk_version = "1.55.0"

// Paths hk must never touch:
// - tsgo/, reference/, include/: vendored or generated mirrors of upstream sources
//   (tsgo/ is regenerated by `go run ./tools/mirror`; hand edits are forbidden).
// - **/testdata/**: compiler fixtures and byte-parity goldens.
// - rotor.schema.json / rbxts-tsconfig.schema.json: must stay byte-identical to the
//   Go constants in internal/config/schema.go and internal/compile/rbxts_schema.go.
// - oxlint.config.ts: imports packages this repo does not install; inert here.
exclude =
  List(
    "node_modules",
    "dist",
    "bin",
    "tsgo",
    "reference",
    "include",
    "**/testdata/**",
    "media",
    "profiles",
    "**/*.prof",
    "**/*-lock.{json,yaml}",
    "mise.lock",
    "roblox-ts.zip",
    "turbo-slop",
    ".omo",
    ".serena",
    ".claude",
    ".agents/skills",
    "rotor.schema.json",
    "rbxts-tsconfig.schema.json",
    "oxlint.config.ts",
  )

display_skip_reasons = List()
terminal_progress = false

// Binary payloads that whitespace/newline/spellcheck steps must skip.
local binary_excludes =
  List(
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.webp",
    "**/*.ico",
    "**/*.woff",
    "**/*.woff2",
    "**/*.ttf",
    "**/*.pdf",
    "**/*.zip",
  )

// File-scoped hygiene, formatting, and linting: runs only over the files a commit touches.
local format_steps = new Mapping<String, Step> {
  ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
    exclude = binary_excludes
  }
  ["newlines"] = (Builtins.newlines) {
    exclude = binary_excludes
  }
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["detect-private-key"] = Builtins.detect_private_key
  // `gitleaks dir` takes a single path: handed several it silently scans the whole working
  // directory instead (node_modules, ignored scratch state), so scan one file per process.
  // Process startup dominates (~240ms each), hence xargs -P; it exits 123 if any scan failed.
  ["gitleaks"] = (Builtins.gitleaks) {
    check = new CommandSpec {
      command =
        """
        for file in {{files}}; do echo "$file"; done |
        xargs -P 8 -I{} gitleaks dir --redact --no-banner --log-level=error {}
        """
      effect = "read"
    }
  }
  ["typos"] = (Builtins.typos) {
    exclude = binary_excludes
  }
  ["gofmt"] = Builtins.go_fmt
  ["biome"] = Builtins.biome
  ["oxfmt"] = Builtins.oxfmt
  // `-i 4`: the repo's shell scripts are 4-space indented; shfmt's tab default would
  // rewrite every line of every script. scripts/release.sh is excluded outright — it is
  // hand-maintained in lockstep with scripts/release.fish and shfmt would rewrite 873
  // of its lines (mostly `(( x ))` -> `((x))`).
  ["shfmt"] = (Builtins.shfmt) {
    exclude = List("scripts/release.sh")
    check_diff = new CommandSpec {
      command = "shfmt -i 4 -d --apply-ignore {{ files }}"
      effect = "read"
    }
    check_list_files = new CommandSpec {
      command =
        """
        files=$(shfmt -i 4 -l --apply-ignore {{ files }})
        if [ -n "$files" ]; then
        echo "$files"
        exit 1
        fi
        """
      effect = "read"
    }
    fix = new CommandSpec {
      command = "shfmt -i 4 -w --apply-ignore {{ files }}"
      effect = "write"
    }
  }
  ["shellcheck"] = Builtins.shellcheck
  ["actionlint"] = Builtins.actionlint
  ["rumdl"] = Builtins.rumdl_format
  ["pkl-format"] = Builtins.pkl_format
}

// Whole-module checks: package-scoped by nature, gated on a matching file being staged.
local validate_steps = new Mapping<String, Step> {
  ["go-vet"] {
    glob = List("**/*.go", "go.mod", "go.sum")
    check = new CommandSpec {
      // Mirrors CI; the vendored tsgo mirror is deliberately excluded.
      command = "go vet ./internal/... ./cmd/... ./tools/..."
      effect = "write"
    }
  }
  ["go-build"] {
    glob = List("**/*.go", "go.mod", "go.sum")
    check = new CommandSpec {
      command = "go build ./..."
      effect = "write"
    }
  }
  ["gomod-tidy"] = Builtins.gomod_tidy
  ["type-check"] {
    glob = List(".omp/**/*.ts", ".omp/tsconfig.json")
    check = new CommandSpec {
      command = "tsgo -p .omp/tsconfig.json --noEmit --pretty false"
      effect = "read"
    }
  }
}

local all_steps = new Mapping<String, Step | Group> {
  ["format"] = new Group {
    steps = format_steps
  }
  ["validate"] = new Group {
    steps = validate_steps
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = all_steps
  }

  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = new CommandSpec {
          command = "commitlint --edit {{commit_msg_file}}"
          effect = "read"
        }
      }
    }
  }

  // `hk check` / `hk run check` — used by CI and by the agent Stop hook.
  ["check"] {
    steps = all_steps
  }

  // `hk fix` — applies every available auto-fix.
  ["fix"] {
    fix = true
    steps = all_steps
  }
}
