amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Builtins.pkl"

min_hk_version = "2.9.0"
display_skip_reasons = List()
terminal_progress = false

// Paths hk must never touch:
// - tsgo/, reference/, include/: vendored or generated mirrors of upstream sources
//   (tsgo/ is regenerated by `go run ./tools/mirror`; hand edits are forbidden).
// - **/testdata/**: compiler fixtures and byte-parity goldens.
// - rotor.schema.json / rbxts-tsconfig.schema.json: must stay byte-identical to the
//   Go constants in internal/config/schema.go and internal/compile/rbxts_schema.go.
exclude =
  List(
    "node_modules",
    "dist",
    "bin",
    "tsgo",
    "reference",
    "include",
    "**/testdata/**",
    "media",
    "profiles",
    "**/*.prof",
    "**/*-lock.{json,yaml}",
    "mise.lock",
    "roblox-ts.zip",
    "turbo-slop",
    ".omo",
    ".serena",
    ".claude",
    ".agents/skills",
    "rotor.schema.json",
    "rbxts-tsconfig.schema.json",
  )

local GO_FILES = List("**/*.go", "go.mod", "go.sum")
local OMP_FILES = List(".omp/**/*.ts", ".omp/tsconfig.json")
// Binary payloads that whitespace, newline, and spellcheck steps must skip.
local BINARY_FILES =
  List(
    "**/*.{png,jpg,jpeg,gif,webp,ico}",
    "**/*.{woff,woff2,ttf}",
    "**/*.{pdf,zip}",
  )

// Patch context and upstream overlay payloads must survive byte-for-byte.
// In particular, spelling fixes must not rewrite third-party license notices.
local MIRROR_INPUTS = List("tools/mirror/patches/**", "tools/mirror/overlay/**")
// Vendored or generated Go mirrors hk must never rewrite. tsgo/ is
// regenerated by `go run ./tools/mirror` (hand edits are forbidden);
// reference/ and include/ are upstream mirrors; testdata holds byte-parity
// goldens. The top-level `exclude` already covers these; the Go steps repeat
// it so write-effect commands never depend on global state alone.
local VENDORED_GO = List("tsgo", "reference", "include", "**/testdata/**")

// Windows runs these hooks under cmd.exe, which shapes two choices below:
// - Builtins whose commands are `sh` snippets (typos, shfmt) run through
//   scripts/check-hook-tools.ts instead.
// - `Command { argv }` execs directly and finds only `.exe` files, never pnpm's
//   `node_modules/.bin/biome.CMD` shim. A string command goes through the shell,
//   which resolves the shim, so `package.json` stays the one biome pin.
local fileChecks = new Mapping<String, Step> {
  // Hygiene.
  ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
    exclude = BINARY_FILES + MIRROR_INPUTS
  }
  ["final-newline"] = (Builtins.newlines) {
    exclude = BINARY_FILES + MIRROR_INPUTS
  }
  ["merge-conflicts"] = Builtins.check_merge_conflict
  ["private-keys"] = Builtins.detect_private_key
  ["typos"] = (Builtins.typos) {
    exclude = BINARY_FILES + MIRROR_INPUTS
    check = new CommandSpec {
      command = new Command {
        argv = List("bun", "run", "scripts/check-hook-tools.ts", "typos", "{{files}}")
      }
      effect = "read"
    }
    check_diff = null
    check_list_files = null
  }

  // Go.
  // `gofumpt -d` / `goimports -d` emit a diff when files need formatting;
  // hk fails the step on diff output, so no wrapper is needed. Both run as
  // `Command { argv }` (not shell strings) so they resolve on Windows cmd.exe.
  ["gofumpt"] {
    glob = List("**/*.go")
    exclude = VENDORED_GO
    check_list_files = null
    check_diff = new CommandSpec {
      command = new Command {
        argv = List("gofumpt", "-d", "{{files}}")
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("gofumpt", "-w", "{{files}}")
      }
      effect = "write"
    }
  }
  ["goimports"] {
    glob = List("**/*.go")
    exclude = VENDORED_GO
    check_list_files = null
    check_diff = new CommandSpec {
      command = new Command {
        argv = List("goimports", "-d", "{{files}}")
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("goimports", "-w", "{{files}}")
      }
      effect = "write"
    }
  }
  ["gomod-tidy"] = Builtins.gomod_tidy

  // TypeScript.
  ["biome"] = (Builtins.biome) {
    check = new CommandSpec {
      command = "biome check --no-errors-on-unmatched {{files}}"
      effect = "write"
    }
    fix = new CommandSpec {
      command = "biome check --write --no-errors-on-unmatched {{files}}"
      effect = "write"
    }
  }
  ["oxfmt"] = Builtins.oxfmt
  // One process for the whole file list: each invocation repays ESLint's startup
  // cost. The script pins both root configs, so nested ones never apply.
  ["isentinel-lint"] {
    glob =
      List(
        "**/*.{ts,tsx,mts,cts,astro}",
        "**/*.{json,jsonc,json5,yaml,yml,toml,css}",
      )
    depends = List("biome")
    batch = false
    check = new CommandSpec {
      command = new Command {
        argv = List("node", "--run", "isentinel-lint", "--", "{{files}}")
      }
      effect = "write"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("node", "--run", "isentinel-lint", "--", "--fix", "{{files}}")
      }
      effect = "write"
    }
  }
  ["type-check"] {
    glob = OMP_FILES
    depends = List("biome")
    check = new CommandSpec {
      command = new Command {
        argv = List("tsrs", "-p", ".omp/tsconfig.json", "--noEmit", "--pretty", "false")
      }
      effect = "read"
    }
  }

  // Shell, workflows, docs, config.
  // `-i 4`: the repo's shell scripts are 4-space indented; shfmt's tab default would
  // rewrite every line of every script.
  ["shfmt"] = (Builtins.shfmt) {
    check_diff = (Builtins.shfmt.check_diff) {
      command = new Command {
        argv = List("shfmt", "-i", "4", "-d", "--apply-ignore", "{{files}}")
      }
    }
    check_list_files = (Builtins.shfmt.check_list_files) {
      command = new Command {
        argv = List("bun", "run", "scripts/check-hook-tools.ts", "shfmt", "{{files}}")
      }
    }
    fix = (Builtins.shfmt.fix) {
      command = new Command {
        argv = List("shfmt", "-i", "4", "-w", "--apply-ignore", "{{files}}")
      }
    }
  }
  ["shellcheck"] = Builtins.shellcheck
  // default profile (`.github/jactionlint.yaml`) is actionlint's checks plus the
  // zizmor rules worth failing a build. `--strict-exit` gates warn and info too,
  // so a later profile bump cannot soften the hook.
  ["jactionlint"] = (Builtins.jactionlint) {
    check = new CommandSpec {
      command = new Command {
        argv = List("jactionlint", "--strict-exit", "--format", "gcc", "{{files}}")
      }
      effect = "read"
    }
    check_diff = new CommandSpec {
      command = new Command {
        argv =
          List(
            "hk",
            "util",
            "sarif-diff",
            "--",
            "jactionlint",
            "--strict-exit",
            "--format",
            "sarif",
            "{{files}}",
          )
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("jactionlint", "--strict-exit", "--fix", "{{files}}")
      }
      effect = "write"
    }
  }
  ["rumdl"] = Builtins.rumdl_format
  ["pkl-format"] = Builtins.pkl_format
}

// Whole-module Go checks. They rebuild the module, so they run on push, not on
// every commit. go-vet and golangci-lint gate the push (minus the vendored
// tsgo mirror, which is deliberately excluded from all of them); govulncheck
// mirrors the CI vuln job's whole-module reachability scan. nilaway and
// deadcode are advisory reports instead: both fail open on the current tree
// (hundreds of pre-existing potential-nil flows, plus reachable-only-from-API
// helpers deadcode will always flag), so gating pre-push on them would never
// go green. They live in `hk run reports` until the backlog is triaged.
local GO_PACKAGES = List("./internal/...", "./cmd/...", "./tools/...")
local moduleChecks = new Mapping<String, Step> {
  ["go-vet"] {
    glob = GO_FILES
    check = new CommandSpec {
      command = new Command {
        argv = List("go", "vet") + GO_PACKAGES
      }
      effect = "write"
    }
  }
  ["go-build"] {
    glob = GO_FILES
    check = new CommandSpec {
      command = new Command {
        argv = List("go", "build", "./...")
      }
      effect = "write"
    }
  }
  ["golangci-lint"] = (Builtins.golangci_lint) {
    glob = GO_FILES
    check = new CommandSpec {
      command = new Command {
        argv = List("golangci-lint", "run", "--fix=false") + GO_PACKAGES
      }
      effect = "write"
    }
    fix = null
  }
  ["govulncheck"] {
    glob = GO_FILES
    check = new CommandSpec {
      command = new Command {
        argv = List("govulncheck", "./...")
      }
      effect = "write"
    }
  }
}

// Materializes `check`, `fix`, and `pre-commit`; `pre-commit` fixes, stages, and
// uses Git stashing by default.
steps = fileChecks

hooks {
  // `hk run reports`: advisory metrics that never gate a commit or push.
  ["reports"] {
    steps {
      ["gocognit"] {
        profiles = List("complexity")
        check = new CommandSpec {
          command = new Command {
            argv =
              List("gocognit", "-over", "30", "-ignore", "_test\\.go$", "internal", "cmd", "tools")
          }
          effect = "read"
        }
      }
      ["nilaway"] {
        check = new CommandSpec {
          command = new Command {
            argv = List("nilaway") + GO_PACKAGES
          }
          effect = "write"
        }
      }
      ["deadcode"] {
        check = new CommandSpec {
          command = new Command {
            argv = List("deadcode") + GO_PACKAGES
          }
          effect = "write"
        }
      }
    }
  }

  ["pre-push"] {
    fix = false
    stage = false
    steps = (fileChecks) {
      ...moduleChecks
      // History scan of the refs being pushed. hk has already consumed git's
      // pre-push stdin; feed it back. A manual `hk run pre-push` has empty
      // stdin and the script scans upstream..HEAD (or all of HEAD).
      ["betterleaks"] {
        stdin = "{{hook_stdin}}"
        check = new CommandSpec {
          command = new Command {
            argv = List("bun", "run", "scripts/betterleaks-pre-push.ts")
          }
          effect = "read"
        }
      }
    }
  }

  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = new CommandSpec {
          command = new Command {
            argv = List("commitlint", "--edit", "{{commit_msg_file}}")
          }
          effect = "read"
        }
      }
    }
  }
}
