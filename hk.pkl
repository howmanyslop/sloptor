amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Builtins.pkl"

min_hk_version = "2.9.0"
display_skip_reasons = List()
terminal_progress = false

// Paths hk must never touch:
// - reference/, include/: vendored mirrors of upstream sources.
// - **/testdata/**: compiler fixtures and byte-parity goldens.
// - rotor.schema.json / rbxts-tsconfig.schema.json: must stay byte-identical to what `sloptor schema` prints.
exclude =
  List(
    "node_modules",
    "dist",
    "bin",
    "reference",
    "include",
    "third_party",
    "target",
    "**/testdata/**",
    "media",
    "profiles",
    "**/*.prof",
    "**/*-lock.{json,yaml}",
    "mise.lock",
    "roblox-ts.zip",
    "turbo-slop",
    ".omo",
    ".serena",
    ".claude",
    ".agents/skills",
    "rotor.schema.json",
    "rbxts-tsconfig.schema.json",
  )

// third_party/tsrs is mirrored by tools/tsrs-mirror and excluded from the Cargo workspace.
local RUST_FILES = List("**/*.rs", "**/Cargo.toml", "Cargo.lock", ".cargo/config.toml")
// editors/zed is the standalone Zed extension with its own rustfmt.toml and lockfile.
local RUST_EXCLUDE = List("third_party/**", "editors/**")
// Rust configuration TOML. tombi validates .cargo/config.toml against the Cargo.toml schema,
// which rejects its [target] table, so it is left out.
local RUST_TOML = List("**/Cargo.toml", "rustfmt.toml", "clippy.toml", "deny.toml")
local OMP_FILES = List(".omp/**/*.ts", ".omp/tsconfig.json")
// Binary payloads that whitespace, newline, and spellcheck steps must skip.
local BINARY_FILES =
  List(
    "**/*.{png,jpg,jpeg,gif,webp,ico}",
    "**/*.{woff,woff2,ttf}",
    "**/*.{pdf,zip}",
  )

// Patch context and upstream overlay payloads must survive byte-for-byte.
// In particular, spelling fixes must not rewrite third-party license notices.
local MIRROR_INPUTS = List("tools/tsrs-mirror/patches/**")
// Windows runs these hooks under cmd.exe, which shapes two choices below:
// - Builtins whose commands are `sh` snippets (typos, shfmt) run through
//   scripts/check-hook-tools.ts instead.
// - `Command { argv }` execs directly and finds only `.exe` files, never pnpm's
//   `node_modules/.bin/biome.CMD` shim. A string command goes through the shell,
//   which resolves the shim, so `package.json` stays the one biome pin.
local fileChecks = new Mapping<String, Step> {
  // Hygiene.
  ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
    exclude = BINARY_FILES + MIRROR_INPUTS
  }
  ["final-newline"] = (Builtins.newlines) {
    exclude = BINARY_FILES + MIRROR_INPUTS
  }
  ["merge-conflicts"] = Builtins.check_merge_conflict
  ["private-keys"] = Builtins.detect_private_key
  ["typos"] = (Builtins.typos) {
    exclude = BINARY_FILES + MIRROR_INPUTS
    check = new CommandSpec {
      command = new Command {
        argv = List("bun", "run", "scripts/check-hook-tools.ts", "typos", "{{files}}")
      }
      effect = "read"
    }
    check_diff = null
    check_list_files = null
  }

  // Rust.
  // The builtins run once per Cargo.toml (`workspace_indicator`), which fails on this
  // repo's virtual workspace root and repeats the work per crate. These run once for the
  // whole workspace instead. No `--all`: it also formats path dependencies, which would
  // reformat third_party/tsrs.
  ["cargo-fmt"] = (Builtins.cargo_fmt) {
    exclude = RUST_EXCLUDE
    workspace_indicator = null
    check = new CommandSpec {
      command = new Command {
        argv = List("cargo", "fmt", "--", "--check")
      }
      effect = "read"
    }
    check_list_files = new CommandSpec {
      command = new Command {
        argv = List("cargo", "fmt", "--", "--check", "--files-with-diff")
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("cargo", "fmt")
      }
      effect = "write"
    }
  }
  ["cargo-clippy"] = (Builtins.cargo_clippy) {
    glob = RUST_FILES
    exclude = RUST_EXCLUDE
    depends = List("cargo-fmt")
    exclusive = true
    // Matches `mise run rust:lint`.
    check = new CommandSpec {
      command = new Command {
        argv =
          List(
            "cargo",
            "clippy",
            "--locked",
            "--workspace",
            "--all-targets",
            "--quiet",
            "--",
            "-D",
            "warnings",
          )
      }
      effect = "write"
    }
  }
  // Advisories, licenses, and sources from deny.toml. Runs only when the manifest,
  // lockfile, or deny.toml changes.
  ["cargo-deny"] = (Builtins.cargo_deny) {
    exclude = RUST_EXCLUDE
    workspace_indicator = null
    dir = null
    // One run for the whole workspace; parallel batches would fight over the advisory
    // database lock.
    batch = false
  }
  ["tombi"] = (Builtins.tombi) {
    glob = RUST_TOML
    exclude = RUST_EXCLUDE
  }
  ["tombi-format"] = (Builtins.tombi_format) {
    glob = RUST_TOML
    exclude = RUST_EXCLUDE
  }

  // TypeScript.
  ["biome"] = (Builtins.biome) {
    check = new CommandSpec {
      command = "biome check --no-errors-on-unmatched {{files}}"
      effect = "write"
    }
    fix = new CommandSpec {
      command = "biome check --write --no-errors-on-unmatched {{files}}"
      effect = "write"
    }
  }
  ["oxfmt"] = Builtins.oxfmt
  // One process for the whole file list: each invocation repays ESLint's startup
  // cost. The script pins both root configs, so nested ones never apply.
  ["isentinel-lint"] {
    glob =
      List(
        "**/*.{ts,tsx,mts,cts,astro}",
        "**/*.{json,jsonc,json5,yaml,yml,toml,css}",
      )
    depends = List("biome")
    batch = false
    check = new CommandSpec {
      command = new Command {
        argv = List("node", "--run", "isentinel-lint", "--", "{{files}}")
      }
      effect = "write"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("node", "--run", "isentinel-lint", "--", "--fix", "{{files}}")
      }
      effect = "write"
    }
  }
  ["type-check"] {
    glob = OMP_FILES
    depends = List("biome")
    check = new CommandSpec {
      command = new Command {
        argv = List("tsrs", "-p", ".omp/tsconfig.json", "--noEmit", "--pretty", "false")
      }
      effect = "read"
    }
  }

  // Shell, workflows, docs, config.
  // `-i 4`: the repo's shell scripts are 4-space indented; shfmt's tab default would
  // rewrite every line of every script.
  ["shfmt"] = (Builtins.shfmt) {
    check_diff = (Builtins.shfmt.check_diff) {
      command = new Command {
        argv = List("shfmt", "-bn", "-ci", "-sr", "-d", "--apply-ignore", "{{files}}")
      }
    }
    check_list_files = (Builtins.shfmt.check_list_files) {
      command = new Command {
        argv = List("bun", "run", "scripts/check-hook-tools.ts", "shfmt", "{{files}}")
      }
    }
    fix = (Builtins.shfmt.fix) {
      command = new Command {
        argv = List("shfmt", "-i", "4", "-w", "--apply-ignore", "{{files}}")
      }
    }
  }
  ["shellcheck"] = Builtins.shellcheck
  // default profile (`.github/jactionlint.yaml`) is actionlint's checks plus the
  // zizmor rules worth failing a build. `--strict-exit` gates warn and info too,
  // so a later profile bump cannot soften the hook.
  ["jactionlint"] = (Builtins.jactionlint) {
    check = new CommandSpec {
      command = new Command {
        argv = List("jactionlint", "--strict-exit", "--format", "gcc", "{{files}}")
      }
      effect = "read"
    }
    check_diff = new CommandSpec {
      command = new Command {
        argv =
          List(
            "hk",
            "util",
            "sarif-diff",
            "--",
            "jactionlint",
            "--strict-exit",
            "--format",
            "sarif",
            "{{files}}",
          )
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("jactionlint", "--strict-exit", "--fix", "{{files}}")
      }
      effect = "write"
    }
  }
  // CHANGELOG.md and the release notes are regenerated from GitHub releases
  // (scripts/sync-release-notes.ts), so their bullet style is GitHub's.
  ["rumdl"] = (Builtins.rumdl_format) {
    exclude = List("CHANGELOG.md", "documentation/src/content/releases/**")
  }
  ["pkl-format"] = Builtins.pkl_format
}

// Materializes `check`, `fix`, and `pre-commit`; `pre-commit` fixes, stages, and
// uses Git stashing by default.
steps = fileChecks

hooks {
  ["pre-push"] {
    fix = false
    stage = false
    steps = (fileChecks) {
      ["cargo-test"] {
        glob = RUST_FILES
        exclude = RUST_EXCLUDE
        depends = List("cargo-clippy")
        exclusive = true
        check = new CommandSpec {
          command = new Command {
            argv = List("cargo", "nextest", "run", "--locked", "--workspace", "--no-tests=pass")
          }
          effect = "write"
        }
      }
      // History scan of the refs being pushed. hk has already consumed git's
      // pre-push stdin; feed it back. A manual `hk run pre-push` has empty
      // stdin and the script scans upstream..HEAD (or all of HEAD).
      ["betterleaks"] {
        stdin = "{{hook_stdin}}"
        check = new CommandSpec {
          command = new Command {
            argv = List("bun", "run", "scripts/betterleaks-pre-push.ts")
          }
          effect = "read"
        }
      }
    }
  }

  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = new CommandSpec {
          command = new Command {
            argv = List("commitlint", "--edit", "{{commit_msg_file}}")
          }
          effect = "read"
        }
      }
    }
  }
}
