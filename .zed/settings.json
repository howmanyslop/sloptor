{
	"always_treat_brackets_as_autoclosed": true,
	"auto_indent": "syntax_aware",
	"code_actions_on_format": {
		"source.fixAll": true,
		"source.organizeImports": true
	},
	"colorize_brackets": true,
	"context_servers": {
		"hk": {
			"args": ["x", "--", "hk", "mcp", "--root", "."],
			"command": "mise",
			"enabled": true,
			"remote": false
		}
	},
	"edit_predictions": {
		"codestral": {},
		"copilot": { "enable_next_edit_suggestions": true },
		"mode": "eager"
	},
	"ensure_final_newline_on_save": true,
	"extend_comment_on_newline": false,
	"file_scan_exclusions": [
		"**/.git",
		"**/.svn",
		"**/.hg",
		"**/.jj",
		"**/.sl",
		"**/.repo",
		"**/CVS",
		"**/.DS_Store",
		"**/Thumbs.db",
		"**/.classpath",
		"**/.settings",
		"**/node_modules"
	],
	"file_types": {
		"HTML": ["svg"],
		"JSONC": [
			"tsconfig.json",
			"jsconfig.json",
			".vscode/*.json",
			".oxfmtrc.json",
			".oxlintrc.json",
			"*.code-workspace",
			"tsconfig*.json",
			"*.code-snippets"
		],
		"Shell Script": ["zsh", "zshrc", "zprofile", "zshenv", "bashrc", "bash_profile"]
	},
	"format_on_save": "on",
	"hard_tabs": true,
	"hidden_files": [".eslintcache*", ".rumdl_cache", "oc1.jsonc"],
	"indent_guides": {
		"active_line_width": 1,
		"background_coloring": "disabled",
		"coloring": "indent_aware",
		"enabled": true,
		"line_width": 1
	},
	"inlay_hints": {
		"edit_debounce_ms": 700,
		"enabled": true,
		"scroll_debounce_ms": 50,
		"show_other_hints": true,
		"show_parameter_hints": true,
		"show_type_hints": true
	},
	"jsx_tag_auto_close": { "enabled": true },
	"languages": {
		"Astro": {
			"format_on_save": "on",
			"formatter": [
				{
					"external": {
						"arguments": ["--run", "biome", "--", "check", "--fix", "--stdin-file-path", "{buffer_path}"],
						"command": "node"
					}
				}
			],
			"hard_tabs": true,
			"language_servers": ["!knip", "astro-language-server", "biome", "..."]
		},
		"CSS": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": false
			},
			"format_on_save": "on",
			"formatter": [
				{
					"language_server": { "name": "biome" }
				},
				{
					"language_server": { "name": "oxfmt" }
				}
			],
			"hard_tabs": true,
			"language_servers": ["!knip", "eslint", "biome", "oxfmt", "..."],
			"prettier": { "allowed": false },
			"tab_size": 4
		},
		"JSON": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"format_on_save": "on",
			"hard_tabs": true,
			"language_servers": [
				"!knip",
				"biome",
				"dependi",
				"deputy",
				"eslint",
				"json-language-server",
				"package-version-server",
				"wakatime",
				"codebook",
				"harper-ls",
				"discord_presence"
			],
			"tab_size": 4
		},
		"JSONC": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"format_on_save": "on",
			"hard_tabs": true,
			"language_servers": [
				"!knip",
				"biome",
				"dependi",
				"deputy",
				"eslint",
				"json-language-server",
				"package-version-server",
				"wakatime",
				"codebook",
				"harper-ls",
				"discord_presence"
			],
			"tab_size": 4
		},
		"JavaScript": {
			"language_servers": [
				"!deno",
				"!knip",
				"!vtsls",
				"!effect-tsgo",
				"!graphql",
				"!typescript-language-server",
				"..."
			]
		},
		"MDX": {
			"format_on_save": "on",
			"language_servers": [
				"oxfmt",
				"rumdl",
				"wakatime",
				"codebook",
				"harper-ls",
				"discord_presence",
				"vale",
				"..."
			],
			"prettier": { "allowed": false }
		},
		"Markdown": {
			"format_on_save": "on",
			"formatter": {
				"language_server": { "name": "rumdl" }
			},
			"hard_tabs": true,
			"language_servers": ["!knip", "codebook", "harper-ls", "rumdl", "wakatime", "vale"],
			"prettier": { "allowed": false },
			"show_whitespaces": "none",
			"soft_wrap": "editor_width",
			"tab_size": 4
		},
		"Pkl": {
			"format_on_save": "on",
			"formatter": {
				"external": {
					"arguments": [
						"-c",
						"temp=$(mktemp -t pkl.XXXXXX.pkl) && cat > $temp && pkl format -w $temp > /dev/null && cat $temp && rm -f $temp"
					],
					"command": "bash"
				}
			},
			"hard_tabs": true,
			"language_servers": ["!knip", "pkl", "wakatime", "codebook", "harper-ls", "discord_presence"],
			"tab_size": 4
		},
		"Shell Script": {
			"format_on_save": "on",
			"formatter": {
				"external": {
					"arguments": ["--filename", "{buffer_path}", "-bn", "-ci", "-sr"],
					"command": "shfmt"
				}
			},
			"hard_tabs": true,
			"language_servers": [
				"!knip",
				"bash-language-server",
				"wakatime",
				"codebook",
				"harper-ls",
				"discord_presence",
				"..."
			],
			"tab_size": 4
		},
		"TOML": {
			"format_on_save": "on",
			"hard_tabs": true,
			"language_servers": [
				"!knip",
				"dependi",
				"deputy",
				"eslint",
				"json-language-server",
				"tombi",
				"wakatime",
				"codebook",
				"harper-ls",
				"discord_presence"
			],
			"tab_size": 4
		},
		"TSX": {
			"code_actions_on_format": {
				"source.addMissingImports": false,
				"source.fixAll.eslint": true,
				"source.fixAll.oxc": true,
				"source.organizeImports": false
			},
			"format_on_save": "on",
			"hard_tabs": true,
			"language_servers": [
				"!deno",
				"!knip",
				"!vtsls",
				"!effect-tsgo",
				"!graphql",
				"!typescript-language-server",
				"..."
			],
			"prettier": { "allowed": false },
			"tab_size": 4
		},
		"TypeScript": {
			"code_actions_on_format": {
				"source.addMissingImports": false,
				"source.fixAll.eslint": true,
				"source.fixAll.oxc": true,
				"source.organizeImports": false
			},
			"format_on_save": "on",
			"hard_tabs": true,
			"language_servers": [
				"!deno",
				"!knip",
				"!vtsls",
				"!effect-tsgo",
				"!graphql",
				"!typescript-language-server",
				"..."
			],
			"prettier": { "allowed": false },
			"tab_size": 4
		},
		"YAML": {
			"format_on_save": "on",
			"hard_tabs": false,
			"language_servers": [
				"!knip",
				"dependi",
				"eslint",
				"json-language-server",
				"yaml-language-server",
				"wakatime",
				"codebook",
				"harper-ls",
				"discord_presence"
			],
			"prettier": { "allowed": false },
			"tab_size": 2
		}
	},
	"linked_edits": true,
	"load_direnv": "direct",
	"lsp": {
		"bash-language-server": {
			"settings": {
				"bashIde": {
					"globPattern": "**/*@(.sh|.inc|.bash|.command|.zsh)"
				}
			}
		},
		"biome": {
			"binary": {
				"arguments": ["--run", "biome", "--", "lsp-proxy"],
				"path": "node"
			},
			"settings": {
				"biome": {
					"configurationPath": "./biome.jsonc",
					"rename": true,
					"requireConfiguration": true
				}
			}
		},
		"eslint": {
			"binary": {
				"env": {
					"ESLINT_IN_EDITOR": "true"
				}
			},
			"settings": {
				"codeActionOnSave": { "mode": "problems" },
				"execArgv": ["--import=jiti/register"],
				"onIgnoredFiles": "off",
				"quiet": true,
				"run": "onType",
				"runtime": "node",
				"workingDirectories": [{ "directory": "." }]
			}
		},
		"golangci-lint": {
			"binary": {
				"arguments": ["x", "--", "golangci-lint-langserver"],
				"path": "mise"
			},
			"initialization_options": {
				"command": [
					"golangci-lint",
					"run",
					"--output.json.path",
					"stdout",
					"--show-stats=false",
					"--issues-exit-code=1",
					"--fix"
				]
			}
		},
		"gopls": {
			"initialization_options": {
				"gofumpt": true,
				"hints": {
					"assignVariableTypes": true,
					"compositeLiteralFields": true,
					"compositeLiteralTypes": true,
					"constantValues": true,
					"functionTypeParameters": true,
					"parameterNames": true,
					"rangeVariableTypes": true
				}
			}
		},
		"mdx-analyzer": {
			"binary": {
				"arguments": ["--run", "mdx-language-server", "--", "--stdio"],
				"path": "node"
			}
		},
		"oxfmt": {
			"initialization_options": {
				"settings": {
					"configPath": "./.oxfmtrc.json",
					"run": "onSave"
				}
			}
		},
		"oxlint": {
			"initialization_options": {
				"settings": {
					"configPath": "oxlint.config.ts",
					"disableNestedConfig": false,
					"fixKind": "safe_fix",
					"typeAware": true
				}
			}
		},
		"typescript-ls": {
			"binary": {
				"arguments": ["--run", "tsgo", "--", "--lsp", "--stdio"],
				"path": "node"
			},
			"settings": {
				"javascript": {
					"inlayHints": {
						"enumMemberValues": { "enabled": true },
						"functionLikeReturnTypes": { "enabled": true },
						"parameterNames": {
							"enabled": "none",
							"suppressWhenArgumentMatchesName": true
						},
						"parameterTypes": { "enabled": false },
						"propertyDeclarationTypes": { "enabled": true }
					},
					"updateImportsOnFileMove": { "enabled": "always" }
				},
				"typescript": {
					"inlayHints": {
						"enumMemberValues": { "enabled": false },
						"functionLikeReturnTypes": { "enabled": false },
						"parameterNames": {
							"enabled": "none",
							"suppressWhenArgumentMatchesName": false
						},
						"parameterTypes": { "enabled": false },
						"propertyDeclarationTypes": { "enabled": false },
						"variableTypes": { "enabled": false }
					},
					"preferences": {
						"autoImportFileExcludePatterns": ["**/node_modules/typescript"],
						"autoImportSpecifierExcludeRegexes": ["^typescript(/.*)?$"]
					}
				}
			}
		},
		"yaml-language-server": {
			"settings": {
				"yaml": {
					"format": { "singleQuote": false },
					"keyOrdering": false,
					"schemas": {
						"./schemas/kubernetes.yaml": "k8s/**/*.yaml",
						"https://json.schemastore.org/dependabot-v2.json": ".github/dependabot.*",
						"https://json.schemastore.org/github-workflow.json": ".github/workflows/*",
						// "~/global-schemas/docker-compose.yaml": "docker-compose*.yml",
						"https://raw.githubusercontent.com/compose-spec/compose-go/master/schema/compose-spec.json": "docker-compose*.yml",
						"https://raw.githubusercontent.com/evilmartians/lefthook/master/schema.json": [
							"lefthook.yml",
							".lefthook.yml",
							"lefthook.yaml",
							".lefthook.yaml",
							"lefthook.json",
							".lefthook.json"
						],
						"https://raw.githubusercontent.com/jdx/jactionlint/main/schema/jactionlint-config.json": [
							".github/jactionlint.yaml",
							".github/jactionlint.yml"
						]
					}
				}
			}
		}
	},
	"prettier": { "allowed": false },
	"remove_trailing_whitespace_on_save": true,
	"show_completion_documentation": true,
	"show_completions_on_input": true,
	"show_edit_predictions": true,
	"soft_wrap": "prefer_line",
	"tab_size": 4,
	"terminal": {
		"shell": "system",
		"working_directory": "current_project_directory"
	},
	"use_auto_surround": true,
	"use_autoclose": true,
	"use_on_type_format": true,
	"word_diff_enabled": true
}
