{
	"globIgnorePaths": ["**/package.json", "**/tsconfig.json"],
	"name": "algorithms",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"TS": { "$path": "out" },
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": { "$path": "node_modules/@rbxts" }
				}
			}
		}
	}
}
