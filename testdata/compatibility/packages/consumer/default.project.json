{
	"name": "compatibility-package-consumer",
	"globIgnorePaths": ["**/package.json", "**/tsconfig.json", "**/*.d.ts"],
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": { "$path": "node_modules/@rbxts" }
				}
			}
		},
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"main": { "$path": "out/main.server.luau" }
		}
	}
}
