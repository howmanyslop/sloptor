---
import SidebarEntryLabel from "$components/overrides/sidebar-entry-label.astro";
import { Icon } from "@astrojs/starlight/components";
import SidebarRestorePoint from "@astrojs/starlight/components/SidebarRestorePoint.astro";

import type { StarlightRouteData } from "@astrojs/starlight/route-data";

type SidebarEntry = StarlightRouteData["sidebar"][number];

interface Props {
	readonly nested?: boolean | undefined;
	readonly sublist: Array<SidebarEntry>;
}

const { sublist, nested } = Astro.props;

function containsCurrent(entries: ReadonlyArray<SidebarEntry>): boolean {
	return entries.some((entry) => (entry.type === "link" ? entry.isCurrent : containsCurrent(entry.entries)));
}
---

<ul class:list={{ "top-level": !nested }}>
	{sublist.map((entry) => (
		<li>
			{entry.type === "link" ? (
				<a
					aria-current={entry.isCurrent ? "page" : undefined}
					href={entry.href}
					class:list={[{ large: !nested }, entry.attrs.class]}
					{...entry.attrs}
				>
					<SidebarEntryLabel badge={entry.badge} label={entry.label} />
				</a>
			) : (
				<details open={containsCurrent(entry.entries) || !entry.collapsed}>
					<summary>
						<span class="group-label">
							<SidebarEntryLabel badge={entry.badge} label={entry.label} large={true} />
						</span>
						<Icon class="caret" name="right-caret" size="1.25rem" />
					</summary>
					<SidebarRestorePoint />
					<Astro.self nested={true} sublist={entry.entries} />
				</details>
			)}
		</li>
	))}
</ul>

<style>
	@layer starlight.core {
		ul {
			--sl-sidebar-item-padding-inline: 0.5rem;
			padding: 0;
			list-style: none;
		}

		li {
			overflow-wrap: anywhere;
		}

		ul ul li {
			padding-inline-start: var(--sl-sidebar-item-padding-inline);
			margin-inline-start: var(--sl-sidebar-item-padding-inline);
			border-inline-start: 1px solid var(--sl-color-hairline-light);
		}

		.large {
			font-size: var(--sl-text-lg);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.top-level > li + li {
			margin-top: 0.75rem;
		}

		summary {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.2em var(--sl-sidebar-item-padding-inline);
			line-height: 1.4;
			cursor: pointer;
			-webkit-user-select: none;
			user-select: none;
		}
		summary::marker,
		summary::-webkit-details-marker {
			display: none;
		}

		.caret {
			flex-shrink: 0;
			transition: transform 0.2s ease-in-out;
		}
		[open] > summary .caret {
			transform: rotateZ(90deg);
		}
		:global([dir="rtl"]) .caret {
			transform: rotateZ(180deg);
		}
		:global([dir="rtl"]) [open] > summary .caret {
			transform: rotateZ(270deg);
		}

		a {
			display: block;
			padding: 0.3em var(--sl-sidebar-item-padding-inline);
			line-height: 1.4;
			color: var(--sl-color-gray-2);
			text-decoration: none;
			border-radius: 0.25rem;
		}

		a:hover,
		a:focus {
			color: var(--sl-color-white);
		}

		[aria-current="page"],
		[aria-current="page"]:hover,
		[aria-current="page"]:focus {
			font-weight: 600;
			color: var(--sl-color-text-invert);
			background-color: var(--sl-color-text-accent);
		}

		a > *:not(:last-child),
		.group-label > *:not(:last-child) {
			margin-inline-end: 0.25em;
		}

		@media (min-width: 50rem) {
			.top-level > li + li {
				margin-top: 0.5rem;
			}
			.large {
				font-size: var(--sl-text-base);
			}
			a {
				font-size: var(--sl-text-sm);
			}
		}
	}
</style>
