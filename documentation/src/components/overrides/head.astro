---
import Default from "@astrojs/starlight/components/Head.astro";

import { createDiscordComponentEmbed, DISCORD_EMBED_ACCENT_COLOR } from "$utilities/discord-component-embed";
import { siteBasePath } from "$utilities/site-base-path";

import { FULL_BUILD_MILLISECONDS } from "../../data/benchmarks";

const DOCS_ORIGIN = "https://docs.howmanysmall.com";
const REPOSITORY_URL = "https://github.com/howmanyslop/sloptor";
const OG_IMAGE_ALT = `A field-notebook card: a cold full build of a 95-file game takes ${FULL_BUILD_MILLISECONDS} milliseconds, printed in slime and tangerine.`;

const route = Astro.locals.starlightRoute;
const origin = Astro.site ?? new URL(DOCS_ORIGIN);
const pageUrl = new URL(Astro.url.pathname, origin).href;
const imageUrl = new URL(`${siteBasePath}og/sloptor.png`, origin).href;
const accentColor = `#${DISCORD_EMBED_ACCENT_COLOR.toString(16).padStart(6, "0")}`;

const discordEmbed = createDiscordComponentEmbed({
	commandsUrl: new URL(`${siteBasePath}commands/`, origin).href,
	description: route.entry.data.description,
	guideUrl: new URL(`${siteBasePath}guide/introduction/`, origin).href,
	imageAlt: `${FULL_BUILD_MILLISECONDS} ms full build of a 95-file production game.`,
	imageUrl,
	pageUrl,
	repositoryUrl: REPOSITORY_URL,
	title: route.entry.data.title,
});
---

<Default />
<meta content={accentColor} name="theme-color" />
<meta content={imageUrl} property="og:image" />
<meta content="2400" property="og:image:width" />
<meta content="1260" property="og:image:height" />
<meta content="image/png" property="og:image:type" />
<meta content={OG_IMAGE_ALT} property="og:image:alt" />
<meta content={imageUrl} name="twitter:image" />
<meta content={OG_IMAGE_ALT} name="twitter:image:alt" />
<!-- biome-ignore lint/nursery/noAstroSetHtmlDirective: Discord reads this JSON verbatim, and a child expression is emitted unparsed. -->
<script id="discord:component-embed" is:inline set:html={discordEmbed} type="application/json"></script>
