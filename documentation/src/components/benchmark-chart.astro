---
import { BENCHMARKS } from "../data/benchmarks";

const SCALE_MAX = 400;
const TICKS = [0, 100, 200, 300, 400];

function toPercent(milliseconds: number): string {
	return `${(milliseconds / SCALE_MAX) * 100}%`;
}
---

<figure class="benchmark-chart">
	<figcaption class="figure-legend">Milliseconds · production games</figcaption>
	<div class="benchmark-well">
		<ol class="benchmark-rows">
			{BENCHMARKS.map(({ files, label, milliseconds }) => (
					<li class="benchmark-row">
						<span class="benchmark-label">
							{label} · {files} files
						</span>
						<span class="benchmark-track">
							<span class="benchmark-bar" style={`inline-size: ${toPercent(milliseconds)}`} />
							<span class="benchmark-value">{milliseconds} ms</span>
						</span>
					</li>
				))}
		</ol>
		<div aria-hidden="true" class="benchmark-axis">
			<span />
			<span class="benchmark-ticks">
				{TICKS.map((tick) => <span style={`inset-inline-start: ${toPercent(tick)}`}>{tick}</span>)}
			</span>
		</div>
	</div>
</figure>
