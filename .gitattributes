* text=auto
*.patch text eol=lf
# Patch context and the verbatim upstream notice contain intentional whitespace.
tools/mirror/patches/*.patch -whitespace
tools/mirror/overlay/NOTICE.tmpl -whitespace
*.lua text eol=lf
*.luau text eol=lf
*.ts text eol=lf
*.json text eol=lf
# Keep CI shell/YAML LF-only so bash `run:` blocks don't break on Linux runners.
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.toml text eol=lf
# Go fuzz corpus seeds must keep their exact bytes (LF); no EOL conversion.
testdata/fuzz/** -text
**/testdata/fuzz/** -text
# Fixture trees are byte-exact goldens: keep the committed bytes on every
# platform. Without this, `* text=auto` rewrites unpinned extensions (.txt,
# .map, .tsx, .js, .md) to CRLF on Windows checkouts and golden compares drift.
testdata/** -text
**/testdata/** -text
# This byte-parity fixture deliberately exercises CRLF and a UTF-8 BOM.
testdata/forkparity/project/performance-output/tree/src/*.ts -text whitespace=-cr-at-eol
# The $file macro inlines this text file byte-for-byte into Luau output.
testdata/compile-unit/macros_model/src/notes.txt -text
# third_party/tsrs is mirrored byte-for-byte by tools/tsrs-mirror (some upstream files are CRLF).
third_party/tsrs/** -text
tools/tsrs-mirror/patches/*.patch -whitespace
# Frozen number-formatting oracle, captured from the retired Go implementation.
crates/rotor_luau/tests/data/jsnumber/*.txt -diff linguist-generated
# Frozen dump of the retired Go checker, kept as the rotor_tsrs differential oracle.
testdata/tsrs-oracle/*.tsv -diff linguist-generated
